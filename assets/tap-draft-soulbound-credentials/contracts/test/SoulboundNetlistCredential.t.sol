// SPDX-License-Identifier: MIT
pragma solidity ^0.8.28;

import {Test} from "forge-std/Test.sol";
import {SoulboundNetlistCredential} from "../src/SoulboundNetlistCredential.sol";
import {
    IERC5192,
    ITapCredential,
    ITapCredentialProven,
    ITapCredentialAttested,
    ITapCredentialClaimed
} from "../src/interfaces/ITapCredential.sol";

/// @notice Replays ../vectors.json (generated by ../make_vectors.py) against the reference contract.
contract SoulboundNetlistCredentialTest is Test {
    SoulboundNetlistCredential internal sbt;
    string internal json;
    address internal constant CONTRACT = 0x00000000000000000000000000000000000000C1;
    address internal a1;
    address internal a2;
    address internal a3;
    address internal a4;

    function setUp() public {
        json = vm.readFile("../vectors.json");
        deployCodeTo(
            "SoulboundNetlistCredential.sol:SoulboundNetlistCredential",
            abi.encode("TAP Soulbound Credentials (test)", "TAPSBT", "https://example.invalid/sbt/"),
            CONTRACT
        );
        sbt = SoulboundNetlistCredential(CONTRACT);
        a1 = vm.parseJsonAddress(json, ".keys[0].address");
        a2 = vm.parseJsonAddress(json, ".keys[1].address");
        a3 = vm.parseJsonAddress(json, ".keys[2].address");
        a4 = vm.parseJsonAddress(json, ".keys[3].address");
    }

    // ------------------------------------------------------------------ helpers

    function _file(string memory name) internal view returns (bytes memory) {
        return vm.parseJsonBytes(json, string.concat(".files.", name, ".file"));
    }

    function _spec(string memory name) internal view returns (ITapCredentialProven.Spec memory s) {
        string memory p = string.concat(".specs.", name, ".spec.");
        s.registrant = vm.parseJsonAddress(json, string.concat(p, "registrant"));
        s.nIn = uint32(vm.parseJsonUint(json, string.concat(p, "nIn")));
        s.nOut = uint32(vm.parseJsonUint(json, string.concat(p, "nOut")));
        s.target = vm.parseJsonBytes32(json, string.concat(p, "target"));
        s.maxGates = uint32(vm.parseJsonUint(json, string.concat(p, "maxGates")));
        s.unique = vm.parseJsonBool(json, string.concat(p, "unique"));
        s.series = vm.parseJsonBytes32(json, string.concat(p, "series"));
        s.commitStart = uint64(vm.parseJsonUint(json, string.concat(p, "commitStart")));
        s.commitEnd = uint64(vm.parseJsonUint(json, string.concat(p, "commitEnd")));
        s.revealEnd = uint64(vm.parseJsonUint(json, string.concat(p, "revealEnd")));
        s.recoveryAuthority = vm.parseJsonAddress(json, string.concat(p, "recoveryAuthority"));
        s.infoHash = vm.parseJsonBytes32(json, string.concat(p, "infoHash"));
    }

    function _att(string memory name) internal view returns (ITapCredentialAttested.Attestation memory a, bytes memory sig) {
        string memory p = string.concat(".attestations.", name, ".message.");
        a.issuer = vm.parseJsonAddress(json, string.concat(p, "issuer"));
        a.recipient = vm.parseJsonAddress(json, string.concat(p, "recipient"));
        a.subject = uint8(vm.parseJsonUint(json, string.concat(p, "subject")));
        a.scope = vm.parseJsonBytes32(json, string.concat(p, "scope"));
        a.artifact = vm.parseJsonBytes32(json, string.concat(p, "artifact"));
        a.evidence = vm.parseJsonBytes32(json, string.concat(p, "evidence"));
        a.issuedAt = uint64(vm.parseJsonUint(json, string.concat(p, "issuedAt")));
        a.expiresAt = uint64(vm.parseJsonUint(json, string.concat(p, "expiresAt")));
        a.deadline = uint64(vm.parseJsonUint(json, string.concat(p, "deadline")));
        a.replaces = vm.parseJsonUint(json, string.concat(p, "replaces"));
        a.nonce = vm.parseJsonBytes32(json, string.concat(p, "nonce"));
        sig = vm.parseJsonBytes(json, string.concat(".attestations.", name, ".signature"));
    }

    function _sig(string memory attestation) internal view returns (bytes memory) {
        return vm.parseJsonBytes(json, string.concat(".attestations.", attestation, ".signature"));
    }

    function _rebindAt(string memory p) internal view returns (ITapCredentialProven.Rebind memory r, bytes memory sig) {
        r.authority = vm.parseJsonAddress(json, string.concat(p, ".message.authority"));
        r.oldTokenId = vm.parseJsonUint(json, string.concat(p, ".message.oldTokenId"));
        r.newHolder = vm.parseJsonAddress(json, string.concat(p, ".message.newHolder"));
        r.deadline = uint64(vm.parseJsonUint(json, string.concat(p, ".message.deadline")));
        r.nonce = vm.parseJsonBytes32(json, string.concat(p, ".message.nonce"));
        sig = vm.parseJsonBytes(json, string.concat(p, ".signature"));
    }

    function _salt(uint256 n) internal pure returns (bytes32) {
        return sha256(abi.encodePacked("tap-soulbound test salt ", vm.toString(n)));
    }

    function _commit(address who, bytes32 id, uint8 subject, bytes memory f, uint256 saltN) internal {
        bytes32 c = sbt.commitmentOf(id, who, subject, sha256(f), _salt(saltN));
        vm.prank(who);
        sbt.commit(id, c);
    }

    // ------------------------------------------------------------------ static vectors

    function test_interfaceIds() public view {
        assertEq(bytes32(type(ITapCredential).interfaceId), bytes32(bytes4(vm.parseJsonBytes(json, ".interfaces.ITapCredential"))));
        assertEq(
            bytes32(type(ITapCredentialProven).interfaceId),
            bytes32(bytes4(vm.parseJsonBytes(json, ".interfaces.ITapCredentialProven")))
        );
        assertEq(
            bytes32(type(ITapCredentialAttested).interfaceId),
            bytes32(bytes4(vm.parseJsonBytes(json, ".interfaces.ITapCredentialAttested")))
        );
        assertEq(
            bytes32(type(ITapCredentialClaimed).interfaceId),
            bytes32(bytes4(vm.parseJsonBytes(json, ".interfaces.ITapCredentialClaimed")))
        );
        assertEq(type(IERC5192).interfaceId, bytes4(0xb45a3c0e));
        assertTrue(sbt.supportsInterface(0xb45a3c0e));
        assertTrue(sbt.supportsInterface(0x80ac58cd)); // ERC-721
        assertTrue(sbt.supportsInterface(0x01ffc9a7)); // ERC-165
        assertTrue(sbt.supportsInterface(type(ITapCredential).interfaceId));
        assertFalse(sbt.supportsInterface(0x282b67f6)); // ITapNetlistNFT (L1) is not claimed
        assertFalse(sbt.supportsInterface(0x49064906)); // ERC-4906: metadata never changes (§3.2)
    }

    function test_fileChecks() public view {
        string[10] memory names = [
            "xor", "xorRenumbered", "xorSwappedInputs", "xorDeadGate", "xorDoubleNegation", "and2", "halfAdder",
            "parity16", "adder8", "parity24"
        ];
        for (uint256 i; i < names.length; i++) {
            (bytes32 dk, bytes32 tt) = sbt.inspect(_file(names[i]));
            assertEq(dk, vm.parseJsonBytes32(json, string.concat(".files.", names[i], ".designKey")), names[i]);
            if (vm.keyExistsJson(json, string.concat(".files.", names[i], ".truthTableHash"))) {
                assertEq(tt, vm.parseJsonBytes32(json, string.concat(".files.", names[i], ".truthTableHash")), names[i]);
            }
        }
    }

    function test_hashes() public view {
        string[5] memory names = ["xor4", "xor4Unique", "xor4UniqueRound2", "parity16", "adder8"];
        for (uint256 i; i < names.length; i++) {
            assertEq(sbt.specId(_spec(names[i])), vm.parseJsonBytes32(json, string.concat(".specs.", names[i], ".specId")));
        }
        assertEq(
            sbt.commitmentOf(
                vm.parseJsonBytes32(json, ".commitments[1].spec"),
                vm.parseJsonAddress(json, ".commitments[1].recipient"),
                1,
                vm.parseJsonBytes32(json, ".commitments[1].netlistHash"),
                vm.parseJsonBytes32(json, ".commitments[1].salt")
            ),
            vm.parseJsonBytes32(json, ".commitments[1].commitment")
        );
        assertEq(_salt(1), vm.parseJsonBytes32(json, ".commitments[0].salt"));
        assertEq(sbt.domainSeparator(), vm.parseJsonBytes32(json, ".eip712.domainSeparator"));
        (ITapCredentialAttested.Attestation memory a,) = _att("valid");
        assertEq(sbt.attestationDigest(a), vm.parseJsonBytes32(json, ".attestations.valid.digest"));
        (ITapCredentialProven.Rebind memory r,) = _rebindAt(".rebind");
        assertEq(sbt.rebindDigest(r), vm.parseJsonBytes32(json, ".rebind.digest"));
        bytes32 st = vm.parseJsonBytes32(json, ".claimStatements.statementId");
        assertEq(sbt.claimScope(st), vm.parseJsonBytes32(json, ".claimStatements.claimScope"));
        assertEq(sbt.claimScope(bytes32(0)), bytes32(0));
    }

    function test_bounds() public view {
        assertEq(sbt.MAX_GATE_WORK(), vm.parseJsonUint(json, ".bounds.maxGateWork"));
        assertEq(sbt.GATE_OVERHEAD(), vm.parseJsonUint(json, ".bounds.gateOverhead"));
        assertEq(sbt.MAX_TABLE_BYTES(), vm.parseJsonUint(json, ".bounds.maxTableBytes"));
        assertEq(sbt.MAX_FILE_BYTES(), vm.parseJsonUint(json, ".bounds.maxFileBytes"));
        assertEq(uint256(sbt.REBIND_DELAY()), vm.parseJsonUint(json, ".bounds.rebindDelay"));
        for (uint256 i; i < 4; i++) {
            string memory p = string.concat(".bounds.examples[", vm.toString(i), "].");
            uint256 nIn = vm.parseJsonUint(json, string.concat(p, "nIn"));
            assertEq(
                sbt.gateWork(nIn, vm.parseJsonUint(json, string.concat(p, "maxGates"))),
                vm.parseJsonUint(json, string.concat(p, "gateWork"))
            );
            assertEq(
                sbt.tableBytes(nIn, vm.parseJsonUint(json, string.concat(p, "nOut"))),
                vm.parseJsonUint(json, string.concat(p, "tableBytes"))
            );
        }
    }

    function test_specChecks() public {
        uint256 n;
        while (vm.keyExistsJson(json, string.concat(".specChecks[", vm.toString(n), "]"))) n++;
        for (uint256 i; i < n; i++) {
            string memory p = string.concat(".specChecks[", vm.toString(i), "]");
            string memory p2 = string.concat(p, ".spec.");
            ITapCredentialProven.Spec memory s;
            s.registrant = vm.parseJsonAddress(json, string.concat(p2, "registrant"));
            s.nIn = uint32(vm.parseJsonUint(json, string.concat(p2, "nIn")));
            s.nOut = uint32(vm.parseJsonUint(json, string.concat(p2, "nOut")));
            s.target = vm.parseJsonBytes32(json, string.concat(p2, "target"));
            s.maxGates = uint32(vm.parseJsonUint(json, string.concat(p2, "maxGates")));
            s.unique = vm.parseJsonBool(json, string.concat(p2, "unique"));
            s.series = vm.parseJsonBytes32(json, string.concat(p2, "series"));
            s.commitStart = uint64(vm.parseJsonUint(json, string.concat(p2, "commitStart")));
            s.commitEnd = uint64(vm.parseJsonUint(json, string.concat(p2, "commitEnd")));
            s.revealEnd = uint64(vm.parseJsonUint(json, string.concat(p2, "revealEnd")));
            s.recoveryAuthority = vm.parseJsonAddress(json, string.concat(p2, "recoveryAuthority"));
            s.infoHash = vm.parseJsonBytes32(json, string.concat(p2, "infoHash"));
            bool ok = vm.parseJsonBool(json, string.concat(p, ".ok"));
            vm.prank(s.registrant);
            try sbt.registerSpec(s) {
                assertTrue(ok, vm.parseJsonString(json, string.concat(p, ".name")));
            } catch {
                assertFalse(ok, vm.parseJsonString(json, string.concat(p, ".name")));
            }
        }
    }

    // ------------------------------------------------------------------ the scenario of vectors.json

    function test_scenario() public {
        // registration
        vm.prank(a1);
        bytes32 id1 = sbt.registerSpec(_spec("xor4Unique"));
        vm.prank(a1);
        bytes32 id2 = sbt.registerSpec(_spec("xor4UniqueRound2"));
        ITapCredentialProven.Spec memory bad = _spec("xor4UniqueRound2");
        bad.commitStart = 4500;
        bad.commitEnd = 4600;
        bad.revealEnd = 4700;
        vm.prank(a1);
        vm.expectRevert(SoulboundNetlistCredential.SeriesOverlap.selector);
        sbt.registerSpec(bad);
        ITapCredentialProven.Spec memory big = _spec("xor4");
        big.nIn = 16;
        big.maxGates = 238;
        vm.prank(a1);
        vm.expectRevert(abi.encodeWithSelector(SoulboundNetlistCredential.BadSpec.selector, "gate work"));
        sbt.registerSpec(big);

        // round 1, with a copied commitment that no longer blocks its owner
        vm.warp(999);
        vm.prank(a2);
        vm.expectRevert(SoulboundNetlistCredential.OutsideWindow.selector);
        sbt.commit(id1, bytes32(uint256(1)));
        bytes32 c2 = sbt.commitmentOf(id1, a2, 0, sha256(_file("xor")), _salt(1));
        vm.warp(1400);
        vm.prank(a1);
        sbt.commit(id1, c2); // front-runner copies the pending commitment
        vm.warp(1500);
        vm.prank(a2);
        sbt.commit(id1, c2);
        vm.warp(1501);
        vm.prank(a2);
        vm.expectRevert(SoulboundNetlistCredential.CommitmentExists.selector);
        sbt.commit(id1, c2);
        vm.warp(1600);
        _commit(a4, id1, 1, _file("xorRenumbered"), 2);
        vm.warp(1999);
        bytes memory xorFile = _file("xor");
        bytes32 salt1 = _salt(1);
        bytes32 salt9 = _salt(9);
        vm.expectRevert(SoulboundNetlistCredential.OutsideWindow.selector);
        sbt.reveal(id1, a2, 0, xorFile, salt1);
        vm.warp(2000);
        vm.expectRevert(SoulboundNetlistCredential.NoCommitment.selector);
        sbt.reveal(id1, a2, 0, xorFile, salt9);
        assertEq(sbt.reveal(id1, a2, 0, xorFile, salt1), 1);
        assertEq(sbt.ownerOf(1), a2);
        vm.warp(2100);
        assertEq(sbt.reveal(id1, a4, 1, _file("xorRenumbered"), _salt(2)), 2); // same-round renamed copy
        assertEq(sbt.credentialOf(2).subject, 1);

        // round 2
        vm.warp(3500);
        _commit(a3, id2, 0, _file("xorSwappedInputs"), 3);
        vm.warp(3600);
        _commit(a3, id2, 0, _file("and2"), 4);
        vm.warp(4000);
        bytes memory swapped = _file("xorSwappedInputs");
        bytes memory and2 = _file("and2");
        bytes32 salt3 = _salt(3);
        bytes32 salt4 = _salt(4);
        vm.expectRevert(abi.encodeWithSelector(SoulboundNetlistCredential.DuplicateDesign.selector, id1));
        sbt.reveal(id2, a3, 0, swapped, salt3);
        vm.warp(4001);
        vm.expectRevert(SoulboundNetlistCredential.WrongFunction.selector);
        sbt.reveal(id2, a3, 0, and2, salt4);

        // proven rebind: delay, veto by the old key, no rebind onto a holder of the specification
        (ITapCredentialProven.Rebind memory r, bytes memory rsig) = _rebindAt(".rebind");
        (ITapCredentialProven.Rebind memory rh, bytes memory rhsig) = _rebindAt(".rebindToHolder");
        (ITapCredentialProven.Rebind memory rv, bytes memory rvsig) = _rebindAt(".rebindVetoed");
        uint64 delay = sbt.REBIND_DELAY();
        vm.warp(5000);
        vm.prank(a2);
        vm.expectRevert(SoulboundNetlistCredential.NotRecipient.selector);
        sbt.requestRebind(r, rsig);
        vm.prank(a4);
        vm.expectRevert(SoulboundNetlistCredential.AlreadyHolds.selector);
        sbt.requestRebind(rh, rhsig);
        vm.prank(a1);
        assertEq(sbt.requestRebind(rv, rvsig), 5000 + delay);
        vm.prank(a1);
        vm.expectRevert(SoulboundNetlistCredential.NotHolder.selector);
        sbt.vetoRebind(2);
        vm.prank(a4);
        sbt.vetoRebind(2);
        vm.warp(5000 + delay);
        vm.prank(a1);
        vm.expectRevert(SoulboundNetlistCredential.NoPendingRebind.selector);
        sbt.completeRebind(2);
        vm.warp(5000);
        vm.prank(a3);
        sbt.requestRebind(r, rsig);
        vm.warp(5001);
        vm.prank(a3);
        vm.expectRevert(SoulboundNetlistCredential.BadSignature.selector); // the same digest: already used
        sbt.requestRebind(r, rsig);
        vm.warp(5000 + delay - 1);
        vm.prank(a3);
        vm.expectRevert(SoulboundNetlistCredential.RebindNotReady.selector);
        sbt.completeRebind(1);
        vm.warp(5000 + delay);
        vm.prank(a3);
        assertEq(sbt.completeRebind(1), 3);
        assertEq(sbt.credentialOf(3).replaces, 1);
        assertTrue(sbt.holdsSpec(id1, a3));
        vm.warp(5001 + delay);
        vm.prank(a3);
        vm.expectRevert(SoulboundNetlistCredential.NotRebindable.selector);
        sbt.requestRebind(r, rsig);

        // claimed, renounce
        vm.warp(700000);
        bytes32 statement = vm.parseJsonBytes32(json, ".claimStatements.statementId");
        vm.prank(a2);
        assertEq(sbt.claim(xorFile, statement, bytes32(0), 0), 4);
        assertEq(sbt.credentialOf(4).issuer, a2);
        assertEq(sbt.credentialOf(4).scope, vm.parseJsonBytes32(json, ".claimStatements.claimScope"));
        vm.prank(a3);
        vm.expectRevert(SoulboundNetlistCredential.NotHolder.selector);
        sbt.renounce(4);
        vm.prank(a2);
        sbt.renounce(4);

        // a request that is not completed lapses; a new Rebind replaces a pending or lapsed one (§4.7)
        {
            (ITapCredentialProven.Rebind memory rl, bytes memory rlsig) = _rebindAt(".rebindLapsed");
            (ITapCredentialProven.Rebind memory r1, bytes memory r1sig) = _rebindAt(".rebindReplacement");
            (ITapCredentialProven.Rebind memory r2, bytes memory r2sig) = _rebindAt(".rebindReplacement2");
            address a5 = vm.parseJsonAddress(json, ".keys[4].address");
            uint256 T = 800000;
            vm.warp(T);
            vm.prank(a1);
            assertEq(sbt.requestRebind(rl, rlsig), T + delay);
            vm.warp(T + 2 * uint256(delay));
            vm.prank(a1);
            vm.expectRevert(SoulboundNetlistCredential.RebindLapsed.selector);
            sbt.completeRebind(2);
            vm.prank(a4);
            vm.expectRevert(SoulboundNetlistCredential.NoPendingRebind.selector);
            sbt.vetoRebind(2);
            vm.prank(a5);
            assertEq(sbt.requestRebind(r1, r1sig), T + 3 * uint256(delay));
            vm.warp(T + 2 * uint256(delay) + 100);
            vm.prank(a1);
            assertEq(sbt.requestRebind(r2, r2sig), T + 3 * uint256(delay) + 100);
            vm.warp(T + 3 * uint256(delay));
            vm.prank(a5);
            vm.expectRevert(SoulboundNetlistCredential.NotRecipient.selector);
            sbt.completeRebind(2);
            vm.prank(a1);
            vm.expectRevert(SoulboundNetlistCredential.RebindNotReady.selector);
            sbt.completeRebind(2);
            vm.warp(T + 3 * uint256(delay) + 50);
            vm.prank(a4);
            sbt.vetoRebind(2);
        }

        // attested
        sbt.storeNetlist(_file("halfAdder"));
        (ITapCredentialAttested.Attestation memory av, bytes memory sv) = _att("valid");
        (ITapCredentialAttested.Attestation memory aw, bytes memory sw) = _att("wrongSigner");
        (ITapCredentialAttested.Attestation memory ag,) = _att("agent");
        bytes memory sgLow = _sig("agentLowV");
        (ITapCredentialAttested.Attestation memory ar, bytes memory sr) = _att("rebind");
        vm.warp(1799999999);
        vm.prank(a2);
        vm.expectRevert(abi.encodeWithSelector(SoulboundNetlistCredential.BadAttestation.selector, "issued in the future"));
        sbt.redeem(av, sv);
        vm.warp(1900000000);
        vm.prank(a2);
        vm.expectRevert(abi.encodeWithSelector(SoulboundNetlistCredential.BadAttestation.selector, "expired"));
        sbt.redeem(av, sv);
        vm.warp(1800000100);
        vm.prank(a1);
        vm.expectRevert(SoulboundNetlistCredential.NotRecipient.selector);
        sbt.redeem(av, sv);
        vm.prank(a2);
        vm.expectRevert(SoulboundNetlistCredential.BadSignature.selector);
        sbt.redeem(aw, sw);
        vm.prank(a2);
        assertEq(sbt.redeem(av, sv), 5);
        assertEq(sbt.credentialOf(5).issuedAt, av.issuedAt); // the attestation's issuedAt is recorded
        vm.warp(1800000200);
        vm.prank(a2);
        vm.expectRevert(SoulboundNetlistCredential.AlreadyRedeemed.selector);
        sbt.redeem(av, sv);
        vm.warp(1800000300);
        vm.prank(a4);
        assertEq(sbt.redeem(ag, sgLow), 6); // v in {0, 1}
        vm.prank(a2);
        vm.expectRevert(SoulboundNetlistCredential.NotIssuer.selector);
        sbt.revokeAttestation(ag);
        vm.prank(a3);
        sbt.revokeAttestation(ag);
        vm.warp(1800000400);
        vm.prank(a4);
        assertEq(sbt.redeem(ar, sr), 7);

        // final states, as in vectors.json
        vm.warp(1800005000);
        uint8[8] memory want = [0, 4, 1, 1, 0, 4, 3, 1];
        for (uint256 t = 1; t <= 7; t++) {
            assertEq(sbt.statusOf(t), want[t], vm.toString(t));
        }
        vm.warp(1900000000);
        assertEq(sbt.statusOf(7), 2); // expired
        vm.warp(1800005000);
        (uint256[] memory ids, uint256 next) = sbt.credentialsOf(a4, 1, address(0), bytes32(0), true, 0, 10);
        assertEq(ids.length, 1);
        assertEq(ids[0], 2);
        assertEq(next, 0);
        (ids,) = sbt.credentialsOf(a4, 2, a3, av.scope, false, 0, 10);
        assertEq(ids.length, 2);
        assertEq(ids[0], 6);
        assertEq(ids[1], 7);
        (ids,) = sbt.credentialsOf(a4, 2, address(0), bytes32(0), true, 0, 10);
        assertEq(ids.length, 1);
        assertEq(ids[0], 7);
        vm.expectRevert(SoulboundNetlistCredential.BadQuery.selector);
        sbt.credentialsOf(a4, 0, address(0), bytes32(0), false, 0, 10);
        vm.expectRevert(SoulboundNetlistCredential.BadQuery.selector);
        sbt.credentialsOf(a4, 1, address(0), bytes32(0), false, 0, 0);
        (ids, next) = sbt.credentialsOf(a4, 2, address(0), bytes32(0), false, 0, 1);
        assertEq(ids[0], 6);
        assertEq(next, 2);
        // cursors after a renounce: the cursor counts every token minted to the holder, renounced ones included
        vm.warp(1800006000);
        vm.prank(a2);
        assertEq(sbt.claim(_file("and2"), bytes32(0), bytes32(0), 0), 8);
        vm.warp(1800006001);
        vm.prank(a2);
        assertEq(sbt.claim(_file("halfAdder"), bytes32(0), bytes32(0), 0), 9);
        vm.warp(1800007000);
        (ids, next) = sbt.credentialsOf(a2, 3, address(0), bytes32(0), false, 0, 1);
        assertEq(ids.length, 1);
        assertEq(ids[0], 8);
        assertEq(next, 4);
        (ids, next) = sbt.credentialsOf(a2, 3, address(0), bytes32(0), false, next, 1);
        assertEq(ids[0], 9);
        assertEq(next, 0);
        vm.warp(1800005000);

        // soulbinding
        assertTrue(sbt.locked(2));
        vm.prank(a4);
        vm.expectRevert(SoulboundNetlistCredential.Soulbound.selector);
        sbt.transferFrom(a4, a2, 2);
        vm.prank(a4);
        vm.expectRevert(SoulboundNetlistCredential.Soulbound.selector);
        sbt.safeTransferFrom(a4, a2, 2);
        vm.prank(a4);
        vm.expectRevert(SoulboundNetlistCredential.Soulbound.selector);
        sbt.approve(a2, 2);
        vm.expectRevert();
        sbt.locked(4); // renounced
        assertEq(sbt.tokenURI(2), "https://example.invalid/sbt/2");
        assertEq(sbt.netlistHashOf(2), sha256(_file("xorRenumbered")));
        assertEq(sbt.netlistFile(sha256(_file("xorRenumbered"))), _file("xorRenumbered"));
        (ITapCredentialProven.Spec memory got, uint256 w, uint256 tb) = sbt.specOf(id1);
        assertEq(got.registrant, a1);
        assertEq(w, sbt.MAX_GATE_WORK());
        assertEq(tb, sbt.MAX_TABLE_BYTES());
    }

    function test_highSRejected() public {
        sbt.storeNetlist(_file("halfAdder"));
        (ITapCredentialAttested.Attestation memory av,) = _att("valid");
        bytes memory hs = vm.parseJsonBytes(json, ".attestations.highS.signature");
        vm.warp(1800000100);
        vm.prank(a2);
        vm.expectRevert(SoulboundNetlistCredential.BadSignature.selector);
        sbt.redeem(av, hs);
    }

    function test_largeFileStoredAndRead() public {
        // a 49,149-byte file is split into two code chunks and read back unchanged
        bytes memory recs = new bytes(7 * 7019);
        for (uint256 k; k < 7019; k++) {
            recs[7 * k + 3] = bytes1(uint8(2));
            recs[7 * k + 6] = bytes1(uint8(3));
        }
        bytes memory f = bytes.concat("TAPNET", hex"0100", bytes4(uint32(2)), bytes4(uint32(1)), recs);
        uint256 g = gasleft();
        bytes32 h = sbt.storeNetlist(f);
        emit log_named_uint("storeNetlist 49,149 bytes gas", g - gasleft());
        assertLt(g - gasleft(), 16_777_216 - 1_000_000);
        assertEq(sbt.netlistFile(h), f);
        vm.expectRevert(SoulboundNetlistCredential.FileTooLarge.selector);
        sbt.storeNetlist(bytes.concat(f, new bytes(7)));
    }
}

/// @notice A contract issuer (ERC-1271) that accepts exactly the digests its owner approved.
contract MockIssuerWallet {
    mapping(bytes32 => bool) public ok;

    function approveDigest(bytes32 h) external {
        ok[h] = true;
    }

    function isValidSignature(bytes32 h, bytes calldata) external view returns (bytes4) {
        return ok[h] ? bytes4(0x1626ba7e) : bytes4(0xffffffff);
    }

    function revoke(SoulboundNetlistCredential sbt, ITapCredentialAttested.Attestation calldata a) external {
        sbt.revokeAttestation(a);
    }
}

contract SoulboundErc1271Test is Test {
    function test_contractIssuer() public {
        SoulboundNetlistCredential sbt = new SoulboundNetlistCredential("t", "t", "u/");
        MockIssuerWallet w = new MockIssuerWallet();
        bytes memory badge = bytes.concat("TAPNET", hex"0100", bytes4(uint32(2)), bytes4(uint32(1)), hex"0000000200000300000004000004");
        bytes32 art = sbt.storeNetlist(badge);
        address bob = address(0xB0B);
        ITapCredentialAttested.Attestation memory a = ITapCredentialAttested.Attestation(
            address(w), bob, 1, sha256("scope"), art, bytes32(0), 1, 0, 0, 0, bytes32(uint256(7))
        );
        bytes32 h = sbt.attestationDigest(a);
        vm.prank(bob);
        vm.expectRevert(SoulboundNetlistCredential.BadSignature.selector);
        sbt.redeem(a, "");
        w.approveDigest(h);
        vm.prank(bob);
        uint256 t = sbt.redeem(a, "");
        assertEq(sbt.credentialOf(t).issuer, address(w));
        assertEq(sbt.credentialOf(t).subject, 1);
        w.revoke(sbt, a);
        assertEq(sbt.statusOf(t), 3);
        (uint8 st, uint256 tok) = sbt.attestationStatus(h);
        assertEq(st, 2);
        assertEq(tok, t);
    }

    /// EIP-7702: an externally owned account with delegated code still signs with its key. The key is tried first,
    /// so a delegation whose isValidSignature rejects everything does not lock the account out.
    function test_eip7702IssuerKeyFirst() public {
        SoulboundNetlistCredential sbt = new SoulboundNetlistCredential("t", "t", "u/");
        bytes memory badge = bytes.concat("TAPNET", hex"0100", bytes4(uint32(2)), bytes4(uint32(1)), hex"0000000200000300000004000004");
        bytes32 art = sbt.storeNetlist(badge);
        uint256 pk = 0xA11CE;
        address issuer = vm.addr(pk);
        vm.etch(issuer, address(new MockIssuerWallet()).code); // code at the key's address, approving nothing
        address bob = address(0xB0B);
        ITapCredentialAttested.Attestation memory a = ITapCredentialAttested.Attestation(
            issuer, bob, 0, sha256("scope"), art, bytes32(0), 1, 0, 0, 0, bytes32(uint256(8))
        );
        (uint8 v, bytes32 r, bytes32 s) = vm.sign(pk, sbt.attestationDigest(a));
        vm.prank(bob);
        uint256 t = sbt.redeem(a, abi.encodePacked(r, s, v));
        assertEq(sbt.credentialOf(t).issuer, issuer);
    }
}
